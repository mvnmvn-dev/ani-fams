APP_NAME="Archon Nell Incorporated"
APP_SUBTITLE="Facilities and Administrative Management System"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost/ani-fams/public

# Optional ARNEL AI service layer (falls back to deterministic local insights when blank)
AI_API_KEY=
AI_API_BASE=https://api.openai.com/v1
AI_MODEL=gpt-5-mini

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=facilities_admin_db
DB_USERNAME=postgres
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync

CACHE_STORE=file
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_TIMEOUT=8
# Required for Resend. Use onboarding@resend.dev for testing (only delivers to your Resend signup email).
MAIL_FROM_ADDRESS=onboarding@resend.dev
MAIL_FROM_NAME="${APP_NAME}"

# OTP email: auto uses Resend when RESEND_API_KEY is set (recommended on Render).
# OTP Gmail on each user = where codes are delivered (recipient), not how mail is sent.
MAIL_OTP_DRIVER=auto
RESEND_API_KEY=

# Set false on hosts where email delivery is unavailable so non-admin login skips OTP.
AUTH_EMAIL_OTP_ENABLED=true
OTP_TTL_MINUTES=10
# Optional: admin OTP destination when otp_email is empty and login email is *.local
# ADMIN_OTP_EMAIL=you@gmail.com

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
